 "roles": [
  {
   "id": "AE_MM",
   "name": "Account Executive (mid-market)",
   "sells": "Heads of Ops and Engineering managers at 200-2000 employee companies",
   "goals": "Close deals faster; run confident discovery",
   "pains": "Ramp time; struggles to explain technical value to engineering managers; unsure which features matter for which use case",
   "needs": "One-sentence value story; the customer problem it solves; one discovery question; when NOT to pitch it"
  },
  {
   "id": "AE_ENT",
   "name": "Account Executive (enterprise)",
   "sells": "CTOs and platform teams at large enterprises",
   "goals": "Win 6-to-7-figure deals with security and IT approval",
   "pains": "Long buying committees; security and compliance objections; competing against build-it-yourself",
   "needs": "Business case; impact on security/compliance/governance; objection handling; proof points for the CTO"
  },
  {
   "id": "SE",
   "name": "Solutions Engineer",
   "sells": "Technical evaluators and architects",
   "goals": "Run convincing demos and proofs of concept",
   "pains": "New features land before demo assets exist; edge cases surface live in front of customers",
   "needs": "How it works; limits and prerequisites; a demo flow; a ready-to-import example workflow"
  },
  {
   "id": "CSM",
   "name": "Customer Success Manager",
   "sells": "Existing customers' automation owners",
   "goals": "Drive adoption and expansion",
   "pains": "Hard to know which accounts benefit from a release; customers miss new capabilities",
   "needs": "Which customer segments benefit; adoption play; a short email to customers; expansion signals"
  },
  {
   "id": "PARTNER",
   "name": "Partner / implementation consultant",
   "sells": "Clients of agencies and consultancies building on n8n",
   "goals": "Deliver client projects faster and resell",
   "pains": "Learns about features late; lacks certified best practices",
   "needs": "Implementation guidance; best practices; certification impact; what to tell clients"
  }
 ],
